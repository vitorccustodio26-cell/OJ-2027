{
  "manifest_version": 3,
  "name": "StudyOS Tracker",
  "version": "0.1.0",
  "description": "Acompanha sessões de questões e envia ao StudyOS. Uso pessoal, somente leitura, sem rede.",
  "permissions": ["storage"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.tecconcursos.com.br/*"],
      "js": ["src/perfis.js", "src/nucleo.js", "src/analisador.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "StudyOS Tracker",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'" }
}
